[Unit]
Description=Pack Matchline volatile runtime into a durable recovery archive
Wants=network-online.target
Requires=matchline-runtime-restore.service
After=network-online.target matchline-runtime-restore.service matchline-prospective-cycle-runtime-only.service
Before=matchline-runtime-readmodel.service
RequiresMountsFor=/media/hetaisheng/044A81D94A81C83E/soccerdata-live-archive/recovery-snapshots

[Service]
Type=oneshot
WorkingDirectory=/home/hetaisheng/soccerdata
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TMPDIR=/dev/shm
Environment=MATCHLINE_RUNTIME_DIR=/dev/shm/matchline-live-runtime
Environment=MATCHLINE_ARCHIVE_DIR=/media/hetaisheng/044A81D94A81C83E/soccerdata-live-archive/recovery-snapshots
EnvironmentFile=-/etc/matchline/matchline-runtime.env
ExecCondition=/usr/bin/test -f ${MATCHLINE_RUNTIME_DIR}/current.json
# This is a recovery copy only.  It never restores rows or promotes a model;
# a separate restore must verify the archive before it can become an input.
# Keep the external volume's one-GiB reserve intact while allowing one old archive
# plus a new temporary archive to coexist during atomic rotation.
ExecStart=/usr/bin/python3 -m league_platform.runtime_archive \
  --runtime-dir=${MATCHLINE_RUNTIME_DIR} \
  --archive-dir=${MATCHLINE_ARCHIVE_DIR} \
  --min-free-bytes=536870912 \
  --keep=1 \
  --compression=zstd
ExecStartPost=/usr/bin/python3 -m league_platform.runtime_archive \
  --verify \
  --manifest=${MATCHLINE_ARCHIVE_DIR}/runtime-archive-manifest.json \
  --verification-receipt=${MATCHLINE_ARCHIVE_DIR}/runtime-archive-verification.json
TimeoutStartSec=20min
TimeoutStopSec=30s
