# Optional operator-managed runtime root.
# The directory must already exist, be writable by the service user and live
# on a filesystem with the configured free-space budget. No files are moved by
# systemd or by the cycle; migrate and verify the existing append-only data
# before switching this value.
#
# Recommended workflow:
#   1. stop the timers;
#   2. copy data/live to the chosen directory and compare hashes/counts;
#   3. switch this value and run one dry/read-only path check;
#   4. resume the timer only after the operator has approved the cutover.
# When --runtime-dir is supplied, the cycle and evaluation evidence pointers
# also default below this root; the model lock remains in docs/evidence and is
# read-only during the storage preflight.
# Must match the runtime root used by matchline-prospective-cycle.service.
# Change only after stopping timers and comparing the append-only ledgers.
# The currently configured legacy path is NTFS3 and has a recorded kernel BUG
# during an atomic post-chain write. Prefer a user-writable ext4/XFS path such
# as /media/hetaisheng/ROS1SIMENV/matchline-live-runtime after an operator has
# fixed that mount's ownership and completed the migration evidence.
MATCHLINE_RUNTIME_DIR=/media/hetaisheng/044A81D94A81C83E/soccerdata-live-runtime

# OpenFootball current and historical rows are consumed only after the raw
# bytes have been fsynced and replayed from this archive.  Keep this explicit even for the
# runtime-only unit: its current.json may live in /dev/shm, but raw provenance
# must not.  sync_live rejects this setting if it resolves below /dev/shm.
MATCHLINE_OPENFOOTBALL_RAW_ARCHIVE_DIR=/media/hetaisheng/044A81D94A81C83E/soccerdata-live-runtime/openfootball-raw

# Durable per-lane cursors and completed receipts. These contain only hashes,
# counts and ACK digests; credentials and producer-local paths are excluded.
MATCHLINE_SITES_SYNC_STATE_DIR=/media/hetaisheng/044A81D94A81C83E/soccerdata-live-runtime/sites-sync-state

# Explicit candidate lock consumed by the runtime-only service. Update this
# only after creating and validating a new candidate lock; never replace an
# active window in place.
MATCHLINE_PROSPECTIVE_LOCK=/home/hetaisheng/soccerdata/docs/evidence/prospective-model-lock-current.json

# The formal prospective cycle requires an independently configured approved
# active lock. Leave this empty until an operator has selected and validated
# that path; the formal service then fails closed rather than treating the
# candidate/current lock above as its own approval.
MATCHLINE_PROSPECTIVE_APPROVED_LOCK=
