# For user services, copy to ~/.config/matchline/matchline-sites.env and chmod 600.
# Keep ~/.config/matchline itself mode 700.
# Do not commit the real token or put it in a unit file.
MATCHLINE_PUBLIC_URL=https://predict.hetaisheng.ccwu.cc
# Server-to-server writes use the official Sites origin. The custom-domain
# alias currently returns an upstream 403 before requests reach the Worker.
MATCHLINE_FIXTURES_REGISTER_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/fixtures/register
MATCHLINE_INGEST_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/ingest
MATCHLINE_FORECAST_REGISTER_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/forecast/register
MATCHLINE_FORECAST_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/forecast
MATCHLINE_PUBLICATION_REGISTER_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/publication/register
MATCHLINE_RAW_ARTIFACT_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/raw-artifacts
MATCHLINE_MET_WEATHER_CACHE_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/v1/weather
MATCHLINE_RESEARCH_FIXTURE_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/research-fixtures
MATCHLINE_PROSPECTIVE_AUDIT_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/prospective-audit
MATCHLINE_ARTIFACT_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/artifacts
MATCHLINE_PUBLICATION_EPOCH=replace-with-d1-deployment-epoch
MATCHLINE_PRODUCER_KEY_ID=replace-with-active-producer-key-id
# HMAC secret must be at least 32 UTF-8 bytes and independent from the Bearer token.
MATCHLINE_PRODUCER_SIGNING_SECRET=replace-with-a-random-32-byte-minimum-signing-secret
# Optional until the stage-evaluation route is deployed and authorized.
# MATCHLINE_STAGE_EVALUATIONS_URL=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/stage-evaluations
MATCHLINE_INGEST_TOKEN=replace-with-a-random-runtime-secret
# Optional for Sites public edges that reject non-browser publisher signatures.
# Obtain a project-scoped value from the Sites connector and keep it in the
# operator-managed 0600 env file; never commit the real token.
# MATCHLINE_SITES_BYPASS_TOKEN=replace-with-a-sites-dispatch-token
# Optional override; the default is a bounded Matchline-compatible browser UA.
# MATCHLINE_PUBLISH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) MatchlinePublisher/1.0
