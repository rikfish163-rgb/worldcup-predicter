[Unit]
Description=Refresh the isolated MET Norway weather cache in Sites R2
Wants=network-online.target
After=network-online.target
ConditionPathExists=%h/.config/matchline/matchline-sites.env

[Service]
Type=oneshot
WorkingDirectory=/home/hetaisheng/soccerdata
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MATCHLINE_RUNTIME_SNAPSHOT=/dev/shm/matchline-live-runtime/current.json
Environment=MATCHLINE_MET_WEATHER_CACHE_ENDPOINT=https://matchline-intelligence.willif57kbkd.chatgpt.site/api/v1/weather
EnvironmentFile=%h/.config/matchline/matchline-sites.env
EnvironmentFile=-/etc/matchline/matchline-runtime.env
EnvironmentFile=-%h/.config/matchline/matchline-runtime.env
ExecStart=/home/hetaisheng/soccerdata/.venv/bin/python -m league_platform.publish_met_weather_cache --runtime-snapshot ${MATCHLINE_RUNTIME_SNAPSHOT} --endpoint ${MATCHLINE_MET_WEATHER_CACHE_ENDPOINT} --max-fixtures 24
TimeoutStartSec=180s
TimeoutStopSec=30s
